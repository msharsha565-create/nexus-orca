{
  "name": "nexus-orca",
  "version": "0.1.0",
  "description": "Run multiple AI coding agents side-by-side in isolated git worktrees",
  "type": "module",
  "bin": { "orca": "dist/cli/orca-cli.js" },
  "scripts": {
